# ---- Core ----
APP_URL=http://localhost:3000
DATABASE_URL=postgres://pinpulse_app:pinpulse_app@localhost:5432/pinpulse        # non-owner role, RLS enforced; migrations
                                        # create it and set its password from here. `next start` (production mode, also
                                        # scripts/test-browser.sh) refuses this default password: use openssl rand -hex 24.
DATABASE_OWNER_URL=postgres://postgres:dev@localhost:5432/pinpulse               # migrations + system jobs only
BETTER_AUTH_SECRET=                     # 32+ random bytes, base64

# ---- Pinterest ----
# mock = talk to services/pinterest-mock (synthetic data, clearly labelled in the UI).
# live = real Pinterest API. Only switch after Standard access + app review are granted; see docs/INTEGRATIONS.md.
PINTEREST_MODE=mock
# Mock port 4410, not the mock's built-in 4010: Windows/WSL often reserves 3980-4079, so a Windows browser can't reach
# 4010 (SPEC-078). The API base is server-to-server; the OAuth base is opened by the browser, so it uses localhost.
PINTEREST_API_BASE=http://127.0.0.1:4410/v5
PINTEREST_OAUTH_BASE=http://localhost:4410/oauth/
PINTEREST_CLIENT_ID=mock-client-id
PINTEREST_CLIENT_SECRET=mock-client-secret
PINTEREST_SCOPES=user_accounts:read,pins:read,boards:read   # read-only; :write scopes are rejected at startup

# ---- Encryption (envelope) ----
TOKEN_KEK_V1=                           # 32-byte base64 KEK; per-connection data keys are wrapped by it
TOKEN_KEK_CURRENT=v1                    # rotation: add TOKEN_KEK_V2, flip, run scripts/rotate-kek.ts

# ---- Analytics service ----
ANALYTICS_URL=http://127.0.0.1:8000
ANALYTICS_TOKEN=                        # shared secret (openssl rand -base64 32); same value on web, worker and analytics.
                                        # Required in production; leave empty for local dev.

# ---- Policy switches (docs/policy/ASSUMPTIONS.md — unresolved assumptions, not approvals) ----
RETENTION_RAW_DAYS=90                   # PA-01
RETENTION_DERIVED_DAYS=395              # PA-01
STORE_PIN_METADATA=true                 # PA-02 (ids, dates, link domain only — never titles/images)
PERSIST_IMAGE_HASHES=false              # PA-03
WEATHER_SOURCE=user_reports             # PA-06
INTEGRITY_UA_MODE=pinterestbot          # PA-07
PROVISIONAL_DAYS=2                      # PA-08
PURGE_DELAY_HOURS=0
REAUTH_GRACE_DAYS=14
TRACKED_PINS_CAP=300

# ---- Integrations (none production-ready; see docs/INTEGRATIONS.md) ----
GA4_MODE=csv                            # csv | mock
SHOPIFY_MODE=csv                        # csv | mock
BILLING_MODE=simulated                  # simulated | paddle_sandbox
PADDLE_WEBHOOK_SECRET=
EMAIL_TRANSPORT=outbox                  # outbox | resend
RESEND_API_KEY=
CHROME_PATH=                            # Chrome/Chromium for PDF rendering; empty = /usr/bin/google-chrome

# ---- Public legal pages (SPEC-071); unset = visible "[to be set: …]" placeholder on /privacy, /terms, /refunds ----
LEGAL_OPERATOR_NAME=                    # legal name of the business operating PinInova
SUPPORT_EMAIL=                          # e.g. support@<domain>
LEGAL_GOVERNING_LAW=                    # e.g. "the laws of <country>"
LEGAL_EFFECTIVE_DATE=                   # e.g. 2026-11-20
REFUND_WINDOW_DAYS=                     # owner decision (billing); e.g. 14 or 30

# ---- Observability (SPEC-072) ----
SENTRY_DSN=                             # empty = nothing is sent; events are scrubbed (no tokens, cookies, bodies, e-mails)
SENTRY_ENVIRONMENT=development          # staging | production
SENTRY_TRACES_SAMPLE_RATE=0             # 0..1; Sentry's SDK exports OpenTelemetry spans (HTTP, fetch, Postgres)
WORKER_STALE_SECONDS=180                # GET /api/health/worker returns 503 when the worker's heartbeat is older

# ---- Dev only ----
INTEGRITY_ALLOW_PRIVATE_HOSTS=false     # true only for local mock sites; refused in production
TRUST_PROXY=false                       # true only behind a proxy that appends the client IP to X-Forwarded-For
# Mock Pinterest (scripts/dev-stack.sh). Port must match PINTEREST_API_BASE / PINTEREST_OAUTH_BASE above.
MOCK_PORT=4410
MOCK_HOST=::                            # all interfaces, IPv4 and IPv6: a browser may resolve localhost to ::1 (WSL)

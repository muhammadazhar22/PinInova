# /opt/pinpulse/.env on the staging server (mode 600, owner deploy). Never commit the filled-in file.
# Every value marked <...> is created by the owner; docs/runbooks/staging-setup.md says where each comes from.

# ---- Hosts (Caddy + app) ----
APP_HOST=staging.<domain>
APP_URL=https://staging.<domain>
ACME_EMAIL=<your e-mail for Let's Encrypt expiry notices>
MOCK_OAUTH_HOST=mock-oauth.<domain>          # only while PINTEREST_MODE=mock; remove at Step 4

# ---- Database (Neon, unpooled endpoint for both) ----
DATABASE_URL=postgres://pinpulse_app:<openssl rand -hex 24>@<ep-xxx>.us-east-1.aws.neon.tech/pinpulse?sslmode=verify-full
DATABASE_OWNER_URL=postgres://neondb_owner:<from Neon>@<ep-xxx>.us-east-1.aws.neon.tech/pinpulse?sslmode=verify-full

# ---- App secrets (openssl rand -base64 32 each) ----
BETTER_AUTH_SECRET=<openssl rand -base64 32>
TOKEN_KEK_V1=<openssl rand -base64 32>       # keep a sealed offline copy: losing it makes stored tokens unreadable
TOKEN_KEK_CURRENT=v1
ANALYTICS_URL=http://analytics:8000
ANALYTICS_TOKEN=<openssl rand -base64 32>

# ---- Pinterest: MOCK until Step 4 (docs/DEPLOYMENT.md) ----
PINTEREST_MODE=mock
PINTEREST_API_BASE=http://pinterest-mock:4010/v5
PINTEREST_OAUTH_BASE=https://mock-oauth.<domain>/oauth/
PINTEREST_CLIENT_ID=mock-client-id
PINTEREST_CLIENT_SECRET=mock-client-secret
PINTEREST_SCOPES=user_accounts:read,pins:read,boards:read
INTEGRITY_ALLOW_PRIVATE_HOSTS=true           # mock websites only; must be false (the app refuses true) in live mode

# ---- Billing (on hold; simulated is accepted only while PINTEREST_MODE=mock) ----
BILLING_MODE=simulated
# PADDLE_WEBHOOK_SECRET=<Paddle sandbox notification secret>   # with BILLING_MODE=paddle_sandbox

# ---- E-mail (Resend) ----
EMAIL_TRANSPORT=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM="PinPulse <noreply@<domain>>"

# ---- Observability ----
SENTRY_DSN=<https://...@o....ingest.sentry.io/...>
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Public legal pages ----
LEGAL_OPERATOR_NAME=<legal name>
SUPPORT_EMAIL=support@<domain>
LEGAL_GOVERNING_LAW=<e.g. the laws of Pakistan>
LEGAL_EFFECTIVE_DATE=<YYYY-MM-DD>
# REFUND_WINDOW_DAYS=<billing decision>

# Policy switches (docs/policy/ASSUMPTIONS.md) keep their defaults unless you decide otherwise:
# RETENTION_RAW_DAYS=90 RETENTION_DERIVED_DAYS=395 STORE_PIN_METADATA=true PERSIST_IMAGE_HASHES=false
# INTEGRITY_UA_MODE=pinterestbot PROVISIONAL_DAYS=2 PURGE_DELAY_HOURS=0 REAUTH_GRACE_DAYS=14
